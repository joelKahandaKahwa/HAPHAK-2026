# ============================================
# HAPHAK 2026 — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs.
# Ne JAMAIS committer le fichier .env réel dans Git.
# ============================================

# --- Application ---
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# --- Base de données ---
# Pour le développement local, le projet utilise SQLite par défaut.
# Vous pouvez aussi brancher une base PostgreSQL/Neon si besoin.
DATABASE_URL=file:./prisma/dev.db

# --- Sessions ---
# Générez une valeur aléatoire longue, ex: `openssl rand -hex 32`
SESSION_SECRET=CHANGE_ME_avec_une_valeur_aleatoire_longue

# --- Compte administrateur initial ---
# Utilisé uniquement par le script `npm run create-admin`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME

# --- Envoi d'e-mails (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="HAPHAK 2026 <no-reply@example.com>"

# --- Divers ---
# Nombre de tentatives de connexion admin avant blocage temporaire
LOGIN_MAX_ATTEMPTS=5
