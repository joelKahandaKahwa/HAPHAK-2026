    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5",
